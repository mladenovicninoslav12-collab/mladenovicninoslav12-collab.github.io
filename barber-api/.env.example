# .env example for barber-api
# Copy this file to .env and fill in real values before running the server

# Port the backend should listen on
PORT=5000

# Frontend URL allowed by CORS (e.g., http://localhost:5500)
FRONTEND_URL=http://localhost:5500

# Gmail account for sending emails (optional)
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_app_password_or_password

# Admin email which will receive new booking notifications
ADMIN_EMAIL=admin@barberelite.rs
